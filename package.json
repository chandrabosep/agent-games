{
  "name": "proof-gatekeeper-agent",
  "version": "1.0.0",
  "private": true,
  "description": "zkVerify Agent Games 2026: Proof Gatekeeper agent",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "steal:commitment": "tsx --env-file-if-exists=.env scripts/steal-commitment.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@noble/hashes": "^2.4.0",
    "better-sqlite3": "^13.1.1",
    "poseidon-lite": "^0.3.0",
    "snarkjs": "0.7.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
