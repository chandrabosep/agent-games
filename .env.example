# Copy to .env for local runs. NEVER commit .env.
# From dashboard -> My Agents -> Rotate Secret (shown once). POSTs get 401 until set.
AGENT_GAMES_HMAC_SECRET=
PORT=8080
# Where the SQLite file lives (Render: /var/data, the persistent disk)
DATA_DIR=data
# How task_id becomes a circuit field element: keccak | sha256 | ascii | hex-digits (unconfirmed, settle in practice)
TASK_ID_ENCODING=keccak
# Proof time cap in ms (shortened further to stay 5 s inside deadline_at)
PROOF_BUDGET_MS=45000
# Kurier (zkVerify) API key: not used in v1 (dispute-evidence worker comes later)
KURIER_API_KEY=
