# Copy to .env for local runs. NEVER commit .env.
# From dashboard -> My Agents -> Rotate Secret (shown once). POSTs get 401 until set.
AGENT_GAMES_HMAC_SECRET=
PORT=8080
# Where the SQLite file lives (Render: /var/data, the persistent disk)
DATA_DIR=data
# How task_id becomes a circuit field element: keccak | sha256 | ascii | hex-digits (unconfirmed, settle in practice)
TASK_ID_ENCODING=keccak
# Proof time cap in ms (shortened further to stay 5 s inside deadline_at)
PROOF_BUDGET_MS=45000
# Optional: Claude writes a plain-language Explanation of each Decision in the background (never affects it).
# Pay-as-you-go key from console.anthropic.com. Unset = explanations off.
ANTHROPIC_API_KEY=
# Kurier (zkVerify) API key: not used in v1 (dispute-evidence worker comes later)
KURIER_API_KEY=
# Steal the VFY entered as a second agent on this endpoint: that agent's Rotate Secret value.
AGENT_GAMES_HMAC_SECRET_STEAL=
# Steal the VFY (Event 02). Your own values, never a model's; never commit or log them.
# Extract amount 1-10, fortify threshold, extract threshold, extract disabled 0|1 (1 = never EXTRACT; circuit's other four are 0).
STRATEGY_PARAMS=
# Random decimal below the BN254 field size; a fresh one for every new commitment.
STRATEGY_SALT=
# The commitment before the latest re-commit, kept while a Match paired under it may still run.
STRATEGY_PARAMS_PREVIOUS=
STRATEGY_SALT_PREVIOUS=
# Proving cap per Turn in ms (the turn window is about 30 s); past it the Turn gets a Fallback HOLD.
STEAL_PROOF_BUDGET_MS=20000
