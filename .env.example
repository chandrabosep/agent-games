# Copy to .env and fill in. NEVER commit .env.
# From dashboard -> My Agents -> Rotate Secret (shown once)
AGENT_GAMES_HMAC_SECRET=
# Kurier (zkVerify) API key - https://docs.zkverify.io/overview/getting-started/kurier
KURIER_API_KEY=
# Optional: enables the LLM explanation step (agent works without it)
ANTHROPIC_API_KEY=
PORT=8080
